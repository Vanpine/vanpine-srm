<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.greensmartplanet.gsc.platform.mapper.PermissionMapper">

    <select id="selectAll" resultType="cn.greensmartplanet.gsc.platform.entity.Permission">
        SELECT id, perm_code, perm_name, sort_order, create_time, update_time
        FROM permission
        WHERE is_deleted = 0
        ORDER BY sort_order ASC
    </select>

</mapper>
