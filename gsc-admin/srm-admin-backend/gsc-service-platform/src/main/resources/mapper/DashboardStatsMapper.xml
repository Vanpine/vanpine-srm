<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.greensmartplanet.gsc.platform.mapper.DashboardStatsMapper">

    <!-- 超管：按状态统计租户（SQL 从旧单体 DashboardMapper 原样迁入） -->
    <select id="countTenantByStatuses" resultType="long">
        SELECT COUNT(*) FROM tenant
        WHERE status IN
        <foreach collection="statuses" item="s" open="(" separator="," close=")">#{s}</foreach>
          AND is_deleted = 0
    </select>

</mapper>
