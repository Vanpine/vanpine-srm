<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.greensmartplanet.gsc.supplier.mapper.SupplierNoteMapper">

    <resultMap id="BaseResultMap" type="cn.greensmartplanet.gsc.supplier.entity.SupplierNote">
        <id column="id" property="id"/>
        <result column="owner_tenant_id" property="ownerTenantId"/>
        <result column="supplier_tenant_id" property="supplierTenantId"/>
        <result column="content" property="content"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 插入供应商备注（ASSIGN_ID 雪花主键：显式写 id=#{id}，由 MyBatis-Plus 填充） -->
    <insert id="insert">
        INSERT INTO supplier_note (id, owner_tenant_id, supplier_tenant_id, content, create_by)
        VALUES (#{id}, #{ownerTenantId}, #{supplierTenantId}, #{content}, #{createBy})
    </insert>

</mapper>
